# ELEKTRİK ANALİZİ · ortam değişkenleri
# Masaüstünde: bu dosyayı ".env" adıyla kopyalayıp doldurun (isteğe bağlı).
# Render'da: aynı adları Dashboard → Environment bölümüne girin. Bu dosyaya gerçek şifre YAZMAYIN.

# Sunucu portu (Render kendisi verir)
PORT=5352

# Verilerin tutulacağı klasör. Render'da kalıcı disk yolu: /var/data
DATA_DIR=

# Giriş: tanımlıysa uygulama kullanıcı adı ve şifre ister. İnternette yayında MUTLAKA doldurun.
APP_KULLANICI=secen
APP_SIFRE=

# EPİAŞ Şeffaflık Platformu hesabı (saatlik PTF + YEKDEM)
EPIAS_KULLANICI=
EPIAS_SIFRE=

# Elektrik Fatura Paneli (yerel ağ). Bulutta kullanılmaz; veri PANEL_SENKRON.bat ile gönderilir.
PANEL_URL=http://192.168.0.106:8010

# Supabase (fatura/GES veritabanı). Masaüstü panel okuyunca yazar, bulut buradan okur.
# Şema: supabase/001_sema.sql · Anahtar: Supabase → Project Settings → API Keys → secret (sb_secret_…)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# (Eski yol, Supabase yoksa) Masaüstü → bulut senkron anahtarı (Render'da otomatik üretilir; masaüstünde aynısını girin)
SENKRON_ANAHTARI=
# Senkron aracının göndereceği bulut adresi (ör. https://elektrik-analizi.onrender.com)
BULUT_URL=

# Mail: masaüstünde Outlook kullanılır. Bulutta (veya MAIL_YONTEMI=smtp ise) SMTP:
MAIL_YONTEMI=
SMTP_HOST=
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_SIFRE=
# Gönderen adres(ler), virgülle: ishak.durmus@scgrup.co
SMTP_GONDEREN=
